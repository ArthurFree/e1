{
  "name": "e1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build",
    "build:desktop": "npm run build:web && node scripts/build-electron.mjs",
    "package:desktop": "npm run build:desktop && electron-builder --dir",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "test:web": "vitest run",
    "test:desktop": "vitest run electron shared src/platform/desktop --passWithNoTests",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --grep-invert \"桌面冒烟|安装包冒烟\"",
    "test:e2e:desktop": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --grep \"桌面冒烟\"",
    "test:e2e:desktop:golden": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --grep \"@golden\"",
    "test:e2e:package": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --grep \"安装包冒烟\"",
    "test:e2e:update": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --grep-invert \"桌面冒烟|安装包冒烟\" --update-snapshots",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "dependency-cruiser src electron shared",
    "test:coverage": "vitest run --coverage --exclude=e2e/** --exclude=node_modules/** --exclude=**/*perf-wallclock.test.ts",
    "ci": "npm run typecheck && npm run lint && npm run deps:check && npm test"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-code-block-lowlight": "^3.28.0",
    "@tiptap/extension-highlight": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-mathematics": "^3.28.0",
    "@tiptap/extension-mention": "^3.28.0",
    "@tiptap/extension-subscript": "^3.28.0",
    "@tiptap/extension-superscript": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extension-typography": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0",
    "chokidar": "^4.0.3",
    "idb": "^8.0.3",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
